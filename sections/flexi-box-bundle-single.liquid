{% comment %}
  Flexi Box Bundle — single page variant.

  Same data source as the step-wise `flexi-box-bundle` section (the product
  metafield `custom.flexi_box_bundle`), but rendered as one flat grid with
  collection filter pills instead of a STEP wizard.

  Each metafield entry becomes one filter pill. The total number of products a
  customer must pick is the SUM of `mandatory_products` across all entries, so
  the existing 1+1+1 setup naturally becomes "pick any 3".

  The step-wise section is untouched — both can run side by side on different
  templates.
{% endcomment %}

{{ 'flexi-box-bundle-single.css' | asset_url | stylesheet_tag }}
<script src="{{ 'flexi-box-bundle-single.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign flexi_box_bundle = product.metafields.custom.flexi_box_bundle.value

  assign total_required = 0
  for step in flexi_box_bundle
    assign total_required = total_required | plus: step.mandatory_products
  endfor
  if total_required == 0
    assign total_required = 3
  endif
-%}

{%- if flexi_box_bundle == blank -%}
  {%- if request.design_mode -%}
    <div class="fbs-empty page-width">
      This product has no <code>custom.flexi_box_bundle</code> metafield set. Add the
      bundle collections to the product metafield to populate this section.
    </div>
  {%- endif -%}
{%- else -%}

  {% comment %}
    Pass 1 — build one "|handle|handle|handle" string per bundle collection so we
    can work out, at render time, every filter a product belongs to. The strings
    are joined with a delimiter and split back into an array, which is the only
    way to keep a list-of-lists in Liquid.
  {% endcomment %}
  {%- liquid
    assign cat_lists = ''
    for step in flexi_box_bundle
      assign one = '|'
      for p in step.collection.value.products
        assign one = one | append: p.handle | append: '|'
      endfor
      assign cat_lists = cat_lists | append: one | append: '<<>>'
    endfor
    assign cat_lists = cat_lists | split: '<<>>'
  -%}

  <div class="fbs" data-total-required="{{ total_required }}">
    <product-form class="fbs__form-wrap">
      {%- form 'product', product,
        class: 'product__form',
        id: 'fbs-form',
        novalidate: 'novalidate',
        data-type: 'add-to-cart-form',
        data-variant-id: product.selected_or_first_available_variant.id,
        data-sku: product.selected_or_first_available_variant.sku,
        data-price: product.selected_or_first_available_variant.price
      -%}

        <div class="fbs__head page-width">
          {%- if section.settings.note != blank -%}
            <div class="fbs__note">{{ section.settings.note }}</div>
          {%- endif -%}

          <h1 class="fbs__heading">
            {%- if section.settings.heading != blank -%}
              {{ section.settings.heading }}
            {%- else -%}
              {{ product.title }}
            {%- endif -%}
          </h1>

          {%- if section.settings.show_search -%}
            <div class="fbs__search">
              <input
                id="fbs-searchbar"
                type="text"
                class="fbs__search-field"
                name="search"
                placeholder="{{ section.settings.search_placeholder | default: 'Search products...' }}"
                onkeypress="return event.keyCode != 13;"
                autocomplete="off"
              >
              <button type="button" class="fbs__search-clear" aria-label="Clear search">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20">
                  <path d="M12.0007 10.5865L16.9504 5.63672L18.3646 7.05093L13.4149 12.0007L18.3646 16.9504L16.9504 18.3646L12.0007 13.4149L7.05093 18.3646L5.63672 16.9504L10.5865 12.0007L5.63672 7.05093L7.05093 5.63672L12.0007 10.5865Z" fill="currentColor"></path>
                </svg>
              </button>
            </div>
          {%- endif -%}

          {% comment %} Filter pills — "All" plus one per bundle collection {% endcomment %}
          <div class="fbs__filters" role="tablist" aria-label="Filter products">
            <button type="button" class="fbs__pill is-active" data-cat="all" role="tab" aria-selected="true">
              {{ section.settings.all_label | default: 'All' }}
            </button>
            {%- for step in flexi_box_bundle -%}
              {%- assign step_collection = step.collection.value -%}
              {%- if step_collection != blank -%}
                {% comment %}
                  The bundle collections are named for the step wizard ("Step 1",
                  "Step 2"...), which reads wrong as a filter. Set
                  `custom.bundle_filter_label` on the collection to override the
                  pill text without renaming the collection itself.
                {% endcomment %}
                {%- assign pill_label = step_collection.metafields.custom.bundle_filter_label.value | default: step_collection.title -%}
                <button type="button" class="fbs__pill" data-cat="{{ forloop.index }}" role="tab" aria-selected="false">
                  {{ pill_label }}
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>

        {% comment %}
          Pass 2 — one flat, de-duplicated grid. A product that sits in more than
          one bundle collection is rendered once and tagged with every filter it
          belongs to.
        {% endcomment %}
        {%- liquid
          assign mobile_layout = section.settings.mobile_layout | default: 'carousel'
          assign desktop_columns = section.settings.desktop_columns | default: 4
        -%}
        <ul
          id="fbs-grid"
          class="fbs__grid fbs__grid--{{ mobile_layout }} page-width"
          style="--fbs-cols: {{ desktop_columns }};"
        >
          {%- liquid
            assign seen = '|'
            assign item_index = 0
          -%}

          {%- for step in flexi_box_bundle -%}
            {%- assign step_collection = step.collection.value -%}
            {%- assign product_limit = step.display_products -%}
            {%- assign shown = 0 -%}

            {% comment %} Curated order first, if the collection defines one {% endcomment %}
            {%- assign sort_order = step_collection.metafields.custom.flexi_box_variant_sort_order.value -%}
            {%- if sort_order != blank -%}
              {%- for sorted_variant in sort_order -%}
                {%- for product_flexi in step_collection.products -%}
                  {%- for variant in product_flexi.variants -%}
                    {%- if variant.id == sorted_variant.id -%}
                      {%- assign key = '|' | append: variant.id | append: '|' -%}
                      {%- unless seen contains key -%}
                        {%- if product_limit == blank or shown < product_limit -%}
                          {%- liquid
                            assign seen = seen | append: variant.id | append: '|'
                            assign shown = shown | plus: 1
                            assign item_index = item_index | plus: 1

                            assign cats = ''
                            for cl in cat_lists
                              assign needle = '|' | append: product_flexi.handle | append: '|'
                              if cl contains needle
                                assign cats = cats | append: forloop.index | append: ' '
                              endif
                            endfor
                          -%}
                          {%- render 'flexi-box-bundle-single-item',
                            product_flexi: product_flexi,
                            variant: variant,
                            cats: cats,
                            item_index: item_index
                          -%}
                        {%- endif -%}
                      {%- endunless -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endfor -%}
              {%- endfor -%}
            {%- endif -%}

            {% comment %} Then everything else in the collection {% endcomment %}
            {%- for product_flexi in step_collection.products -%}
              {%- for variant in product_flexi.variants -%}
                {%- assign key = '|' | append: variant.id | append: '|' -%}
                {%- unless seen contains key -%}
                  {%- if product_limit == blank or shown < product_limit -%}
                    {%- liquid
                      assign seen = seen | append: variant.id | append: '|'
                      assign shown = shown | plus: 1
                      assign item_index = item_index | plus: 1

                      assign cats = ''
                      for cl in cat_lists
                        assign needle = '|' | append: product_flexi.handle | append: '|'
                        if cl contains needle
                          assign cats = cats | append: forloop.index | append: ' '
                        endif
                      endfor
                    -%}
                    {%- render 'flexi-box-bundle-single-item',
                      product_flexi: product_flexi,
                      variant: variant,
                      cats: cats,
                      item_index: item_index
                    -%}
                  {%- endif -%}
                {%- endunless -%}
              {%- endfor -%}
            {%- endfor -%}
          {%- endfor -%}
        </ul>

        <p class="fbs__no-results" hidden>No products match your search.</p>

        {% comment %} Sticky selection tray {% endcomment %}
        <div class="fbs-tray" data-state="empty">
          <div class="fbs-tray__inner page-width">
            <div class="fbs-tray__left">
              <div class="fbs-tray__slots">
                {%- for i in (1..total_required) -%}
                  <div class="fbs-tray__slot" data-slot="{{ forloop.index }}">
                    <span class="fbs-tray__slot-plus" aria-hidden="true">+</span>
                  </div>
                {%- endfor -%}
              </div>
              <div class="fbs-tray__copy">
                <p class="fbs-tray__count">
                  <span class="fbs-tray__count-current">0</span>/<span class="fbs-tray__count-total">{{ total_required }}</span> Added
                </p>
                <p class="fbs-tray__hint"
                  data-unlock-singular="{{ section.settings.unlock_singular | default: 'Add 1 More To Unlock' }}"
                  data-unlock-plural="{{ section.settings.unlock_plural | default: 'Add [n] More To Unlock' }}"
                  data-unlock-done="{{ section.settings.unlock_done | default: 'Your box is ready!' }}"
                  data-unlock-price="{{ product.price | money_without_trailing_zeros }}"
                ></p>
              </div>
            </div>

            <div class="fbs-tray__right">
              <div class="fbs-tray__price">
                <span class="fbs-tray__price-label">{{ section.settings.price_label | default: 'Deal Price:' }}</span>
                <span class="fbs-tray__price-amounts">
                  <span class="fbs-tray__price-value">{{ product.price | money_without_trailing_zeros }}</span>
                  {% comment %} Filled by JS with the sum of the selected items {% endcomment %}
                  <s class="fbs-tray__price-compare" hidden></s>
                </span>
              </div>
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <button
                type="submit"
                id="fbs-submit"
                name="add"
                class="fbs-tray__atc btn btn--large btn--submit product__submit__add"
                disabled
                {%- if product.selected_or_first_available_variant.available == false %} data-unavailable{% endif -%}
                data-add-to-cart
              >
                {%- liquid
                  if product.selected_or_first_available_variant.available
                    echo 'products.product.add_to_cart' | t
                  else
                    echo 'products.product.sold_out' | t
                  endif
                -%}
                <em class="loader loader--line"><em class="loader-indeterminate"></em></em>
              </button>
            </div>

            <button type="button" class="fbs-tray__expand" aria-label="View your box" aria-expanded="false" aria-controls="fbs-sheet">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none">
                <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>

        {% comment %}
          "Your Box" panel. It lives INSIDE the tray so the floating card simply
          grows upward when opened, rather than a separate sheet sliding over the
          page — the tray's own inner row is hidden while it is open.
        {% endcomment %}
        <div
          class="fbs-sheet"
          id="fbs-sheet"
          hidden
          role="dialog"
          aria-modal="true"
          aria-labelledby="fbs-sheet-title"
          data-remove-label="{{ section.settings.remove_label | default: 'Remove' | escape }}"
          data-saved-label="{{ section.settings.saved_label | default: 'You saved [amount]' | escape }}"
          data-placeholder-label="{{ section.settings.placeholder_label | default: 'Product' | escape }}"
          data-bundle-price="{{ product.price }}"
        >
            <div class="fbs-sheet__head">
              <h2 class="fbs-sheet__title" id="fbs-sheet-title">
                {{ section.settings.sheet_title | default: 'Your Box' }}
                (<span class="fbs-sheet__count">0</span>/{{ total_required }})
              </h2>
              <button type="button" class="fbs-sheet__close" aria-label="Close" data-fbs-sheet-close>
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none">
                  <path d="M6 6L18 18M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </button>
            </div>

            <div class="fbs-sheet__body">
              <ul class="fbs-sheet__items"></ul>

              <p class="fbs-sheet__empty" hidden>
                {{ section.settings.sheet_empty | default: 'Your box is empty. Add products to get started.' }}
              </p>

              <div class="fbs-sheet__bill" hidden>
                <div class="fbs-sheet__bill-head">
                  <span class="fbs-sheet__bill-title">{{ section.settings.bill_title | default: 'Bill Summary' }}</span>
                  <span class="fbs-sheet__saved" hidden></span>
                </div>
                <dl class="fbs-sheet__bill-rows">
                  <div class="fbs-sheet__bill-row">
                    <dt>{{ section.settings.subtotal_label | default: 'Subtotal' }} (<span class="fbs-sheet__bill-count">0</span> <span class="fbs-sheet__bill-unit">items</span>)</dt>
                    <dd class="fbs-sheet__subtotal"></dd>
                  </div>
                  <div class="fbs-sheet__bill-row fbs-sheet__bill-row--discount" hidden>
                    <dt>{{ section.settings.discount_label | default: 'Bundle Discount' }}</dt>
                    <dd class="fbs-sheet__discount"></dd>
                  </div>
                  <div class="fbs-sheet__bill-row fbs-sheet__bill-row--total">
                    <dt>{{ section.settings.total_label | default: 'Total' }}</dt>
                    <dd class="fbs-sheet__total"></dd>
                  </div>
                </dl>
              </div>
            </div>

            <div class="fbs-sheet__foot">
              <div class="fbs-tray__price">
                <span class="fbs-tray__price-label">{{ section.settings.price_label | default: 'Deal Price:' }}</span>
                <span class="fbs-tray__price-amounts">
                  <span class="fbs-tray__price-value">{{ product.price | money_without_trailing_zeros }}</span>
                  <s class="fbs-tray__price-compare" hidden></s>
                </span>
              </div>
              {% comment %}
                Proxy button — the real submit lives in the tray, and two elements
                with the same id inside one form would be invalid.
              {% endcomment %}
              <button type="button" class="fbs-tray__atc fbs-sheet__atc" disabled>
                {{ 'products.product.add_to_cart' | t }}
              </button>
            </div>
        </div>
        </div>

        {% comment %}
          Backdrop is a sibling of the tray, not a child: the tray is
          transform-centred on desktop, and a transformed ancestor becomes the
          containing block for fixed children, which would trap it inside the card.
        {% endcomment %}
        <div class="fbs-sheet-backdrop" data-fbs-sheet-close hidden></div>
      {%- endform -%}
    </product-form>
  </div>

  {% comment %} Reused from the step-wise bundle — quick view popup {% endcomment %}
  {%- render 'flexi-box-bundle-item-popup' -%}

  <div class="message-bar is-hidden">
    <div class="message message--green">
      <div class="message-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="9" viewBox="0 0 11 9" fill="none">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M9.66802 1.37429L4.48642 7.85309L0.416016 4.46069L1.18402 3.53909L4.31362 6.14669L8.73201 0.625488L9.66802 1.37429Z" fill="#000" stroke="#000" stroke-width="0.5"/>
        </svg>
      </div>
      <div class="message-body">
        <p><span></span> added to box</p>
      </div>
    </div>
  </div>
{%- endif -%}

{%- schema -%}
{
  "name": "Flexi box bundle (single)",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the product title."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note above heading",
      "default": "Note: This offer cannot be combined with any codes"
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "\"All\" filter label",
      "default": "All"
    },
    {
      "type": "header",
      "content": "Product layout"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "info": "Carousel shows one swipeable row. Grid stacks products two per row, like the step-wise bundle.",
      "options": [
        { "value": "carousel", "label": "Carousel (swipe sideways)" },
        { "value": "grid", "label": "Grid (2 per row)" }
      ],
      "default": "carousel"
    },
    {
      "type": "select",
      "id": "desktop_columns",
      "label": "Products per row on desktop",
      "info": "Applies on wide screens. Tablets always show 3 per row.",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "header",
      "content": "Selection tray"
    },
    {
      "type": "text",
      "id": "price_label",
      "label": "Price label",
      "default": "Deal Price:"
    },
    {
      "type": "text",
      "id": "unlock_singular",
      "label": "Hint — 1 remaining",
      "default": "Add 1 More To Unlock"
    },
    {
      "type": "text",
      "id": "unlock_plural",
      "label": "Hint — more than 1 remaining",
      "info": "Use [n] for the number remaining.",
      "default": "Add [n] More To Unlock"
    },
    {
      "type": "text",
      "id": "unlock_done",
      "label": "Hint — box complete",
      "info": "Use [price] for the bundle price.",
      "default": "You've Unlocked [price] Deal Price"
    },
    {
      "type": "header",
      "content": "\"Your Box\" sheet"
    },
    {
      "type": "text",
      "id": "sheet_title",
      "label": "Sheet title",
      "default": "Your Box"
    },
    {
      "type": "text",
      "id": "sheet_empty",
      "label": "Empty state text",
      "default": "Your box is empty. Add products to get started."
    },
    {
      "type": "text",
      "id": "remove_label",
      "label": "Remove link text",
      "default": "Remove"
    },
    {
      "type": "text",
      "id": "placeholder_label",
      "label": "Empty slot label",
      "default": "Product"
    },
    {
      "type": "text",
      "id": "bill_title",
      "label": "Bill summary heading",
      "default": "Bill Summary"
    },
    {
      "type": "text",
      "id": "subtotal_label",
      "label": "Subtotal label",
      "default": "Subtotal"
    },
    {
      "type": "text",
      "id": "discount_label",
      "label": "Discount label",
      "default": "Bundle Discount"
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Total label",
      "default": "Total"
    },
    {
      "type": "text",
      "id": "saved_label",
      "label": "Savings badge",
      "info": "Use [amount] for the amount saved.",
      "default": "You saved [amount]"
    },
    {
      "type": "header",
      "content": "Search"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search bar",
      "default": false
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search products..."
    }
  ],
  "presets": [
    {
      "name": "Flexi box bundle (single)"
    }
  ]
}
{%- endschema -%}
