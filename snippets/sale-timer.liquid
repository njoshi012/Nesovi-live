{%- doc -%}
  Compact sale countdown for the announcement bar and the cart drawer.
  Configured once in Theme settings > Sale timer; uses assets/urgency-sale-timer.js.
  With no end date it counts down to the end time every day.

  @param {string} placement - 'announcement' or 'cart'

  @example
  {% render 'sale-timer', placement: 'cart' %}
{%- enddoc -%}

{%- liquid
  assign show_timer = false
  if placement == 'announcement' and settings.sale_timer_announcement
    assign show_timer = true
    assign timer_text = settings.sale_timer_announcement_text
  elsif placement == 'cart' and settings.sale_timer_cart
    assign show_timer = true
    assign timer_text = settings.sale_timer_cart_text
  endif
-%}

{%- if show_timer -%}
  {%- liquid
    assign end_date = settings.sale_timer_end_date | strip
    assign end_time = settings.sale_timer_end_time | strip
    if end_time == blank
      assign end_time = '23:59'
    endif

    assign end_datetime = ''
    if end_date != blank
      assign end_datetime = end_date | append: 'T' | append: end_time | append: ':00'
    endif

    assign restart_value = settings.sale_timer_restart_value | default: 1
    case settings.sale_timer_restart_unit
      when 'hours'
        assign restart_ms = restart_value | times: 3600000
      when 'weeks'
        assign restart_ms = restart_value | times: 604800000
      else
        assign restart_ms = restart_value | times: 86400000
    endcase
  -%}

  <script
    src="{{ 'urgency-sale-timer.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>

  {%- comment -%} Stable id + data-skip-subtree-update: cart re-renders morph the drawer without resetting a running timer. {%- endcomment -%}
  <div
    id="SaleTimer-{{ placement }}"
    class="sale-timer sale-timer--{{ placement }}"
    style="--sale-timer-bg: {{ settings.sale_timer_bg }}; --sale-timer-fg: {{ settings.sale_timer_text }}; --sale-timer-box-bg: {{ settings.sale_timer_box_bg }}; --sale-timer-box-fg: {{ settings.sale_timer_box_text }};"
    data-skip-subtree-update
  >
    <urgency-sale-timer-component
      class="sale-timer__inner"
      end-datetime="{{ end_datetime }}"
      end-time="{{ end_time | escape }}"
      on-expire="{{ settings.sale_timer_on_expire }}"
      restart-ms="{{ restart_ms }}"
      hide-self
      hide-empty-days
    >
      {%- if timer_text != blank -%}
        <span class="sale-timer__text">{{ timer_text | escape }}</span>
      {%- endif -%}
      <span class="sale-timer__display" data-urgency-timer-display>
        {%- assign timer_parts = 'days:d,hours:h,minutes:m,seconds:s' | split: ',' -%}
        {%- for part in timer_parts -%}
          {%- assign part_name = part | split: ':' | first -%}
          {%- assign part_suffix = part | split: ':' | last -%}
          <span class="sale-timer__unit" data-urgency-timer-unit="{{ part_name }}">
            <span data-urgency-timer-{{ part_name }}>00</span>{{ part_suffix -}}
          </span>
        {%- endfor -%}
      </span>
      <span class="sale-timer__text" data-urgency-timer-message hidden>
        {{- settings.sale_timer_expired_message | default: 'This sale has ended.' | escape -}}
      </span>
    </urgency-sale-timer-component>
  </div>
{%- endif -%}

{% stylesheet %}
  .sale-timer {
    background: var(--sale-timer-bg);
    color: var(--sale-timer-fg);
  }

  .sale-timer [hidden] {
    display: none !important;
  }

  .sale-timer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px 10px;
    padding: 6px 12px;
    font-family: var(--font-body--family);
    font-size: 13px;
    line-height: 1.2;
    font-weight: 600;
    text-align: center;
  }

  .sale-timer__display {
    display: inline-flex;
    gap: 4px;
  }

  .sale-timer__unit {
    min-width: 34px;
    padding: 3px 5px;
    border-radius: 4px;
    background: var(--sale-timer-box-bg);
    color: var(--sale-timer-box-fg);
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }

  .sale-timer--cart {
    flex-shrink: 0;
  }

  .sale-timer--cart .sale-timer__inner {
    padding: 8px var(--cart-drawer-padding, 16px);
  }

  @media screen and (max-width: 749px) {
    .sale-timer__inner {
      font-size: 12px;
    }

    .sale-timer__unit {
      min-width: 30px;
    }
  }
{% endstylesheet %}
