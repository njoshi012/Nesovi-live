{%- doc -%}
  Renders a site-wide popup inviting visitors to join the Nesovi WhatsApp community.

  Shows once per browser session on a short delay. Closing the popup (X, backdrop click,
  or Escape) suppresses it for the rest of the session. Clicking "Don't show again"
  suppresses it permanently for that browser via localStorage.
{%- enddoc -%}

<dialog-component
  id="whatsapp-community-popup"
  class="whatsapp-popup"
  data-delay="3000"
>
  <dialog
    ref="dialog"
    class="whatsapp-popup__content"
    scroll-lock
  >
    <button
      ref="closeButton"
      on:click="/closeDialog"
      class="button button-unstyled whatsapp-popup__close"
      aria-label="{{ 'accessibility.close_dialog' | t }}"
    >
      {{- 'icon-close.svg' | inline_asset_content -}}
    </button>

    <img
      src="https://cdn.shopify.com/s/files/1/0651/4196/5007/files/community_popup.png?v=1788174179"
      alt="Join the Nesovi Insider WhatsApp community"
      class="whatsapp-popup__image"
      width="600"
      height="600"
      loading="lazy"
    >

    <div class="whatsapp-popup__footer">
      <a
        href="https://chat.whatsapp.com/In3NTOnp3ZjEXYVYq5cNeI"
        target="_blank"
        rel="noopener noreferrer"
        class="whatsapp-popup__cta"
        data-whatsapp-popup-join
      >
        <svg
          class="whatsapp-popup__cta-icon"
          aria-hidden="true"
          focusable="false"
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 20 20"
        >
          {%- render 'icon', icon: 'whatsapp' -%}
        </svg>
        Join the Club of Champions!
      </a>

      <button
        type="button"
        class="button button-unstyled whatsapp-popup__dismiss"
        data-whatsapp-popup-dismiss
      >
        Don't show again
      </button>
    </div>
  </dialog>
</dialog-component>

<script
  src="{{ 'whatsapp-community-popup.js' | asset_url }}"
  type="module"
></script>

{% stylesheet %}
  dialog.whatsapp-popup__content {
    box-sizing: border-box;
    padding: 0;
    border: none;
    width: min(24rem, calc(100dvw - 2rem));
    max-width: 24rem;
    max-height: min(34rem, calc(100dvh - 2rem));
    height: fit-content;
    margin: auto;
    border-radius: 16px;
    overflow: hidden;
    background-color: var(--color-background, #ffffff);
    box-shadow: 0 20px 60px rgb(0 0 0 / 0.3);
  }

  .whatsapp-popup__content::backdrop {
    background-color: rgb(0 0 0 / 0.55);
    opacity: 0;
  }

  @keyframes whatsapp-popup-fade-in {
    to {
      opacity: 1;
    }
  }

  @keyframes whatsapp-popup-slide-in-up {
    from {
      transform: translateY(100px);
      opacity: 0;
    }

    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  @keyframes whatsapp-popup-slide-out-down {
    from {
      transform: translateY(0);
      opacity: 1;
    }

    to {
      transform: translateY(100px);
      opacity: 0;
    }
  }

  .whatsapp-popup__content[open] {
    animation: whatsapp-popup-slide-in-up 450ms cubic-bezier(0.16, 1, 0.3, 1) forwards;

    &::backdrop {
      animation: whatsapp-popup-fade-in 350ms ease forwards;
    }
  }

  .whatsapp-popup__content.dialog-closing {
    animation: whatsapp-popup-slide-out-down 250ms ease-in forwards;

    &::backdrop {
      opacity: 0;
    }
  }

  .whatsapp-popup__close {
    position: absolute;
    top: var(--padding-sm, 0.8rem);
    right: var(--padding-sm, 0.8rem);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
  }

  .whatsapp-popup__image {
    display: block;
    width: 100%;
    height: auto;
  }

  .whatsapp-popup__footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    padding: var(--padding-md, 1.6rem) var(--padding-md, 1.6rem) var(--padding-lg, 2rem);
  }

  .whatsapp-popup__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.85rem 1.4rem;
    border-radius: 999px;
    background-color: #25d366;
    color: #ffffff;
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.3;
    text-decoration: none;
    text-align: center;
    transition: background-color var(--animation-speed, 200ms) var(--animation-easing, ease);
  }

  .whatsapp-popup__cta:hover {
    background-color: #1ebe5b;
  }

  .whatsapp-popup__cta-icon {
    flex-shrink: 0;
    color: #ffffff;
  }

  .whatsapp-popup__dismiss {
    color: var(--color-foreground);
    opacity: 0.6;
    font-size: 0.85rem;
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }

  .whatsapp-popup__dismiss:hover {
    opacity: 1;
  }
{% endstylesheet %}
